<!DOCTYPE html>
<html>
  <head>
    <base target="_top">
    <style>
      body { font-family: Arial, sans-serif; padding: 15px; color: #333; }
      .field { margin-bottom: 15px; }
      label { display: block; margin-bottom: 5px; font-weight: bold; }
      input[type="text"] { width: 95%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; }
      .btn { background-color: #1a73e8; color: white; padding: 10px 15px; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; font-size: 14px; display: inline-block; }
      .btn:hover { background-color: #1557b0; }
    </style>
  </head>
  <body>
    <div class="field">
      <label for="filename">Укажите имя файла (без .xml):</label>
      <input type="text" id="filename" value="export_data">
    </div>

    <button class="btn" id="processBtn" onclick="startDownload()">Сгенерировать и скачать</button>
    <a id="downloadLink" style="display:none;"></a>

    <script>
      function startDownload() {
        var btn = document.getElementById('processBtn');
        btn.innerText = 'Подготовка...';
        btn.disabled = true;

        // Вызываем серверную функцию генерации данных
        google.script.run.withSuccessHandler(function(base64Data) {
          var userFileName = document.getElementById('filename').value.trim() || 'export';
          if(!userFileName.endsWith('.xml')) { userFileName += '.xml'; }

          var link = document.getElementById('downloadLink');
          link.href = "data:text/xml;charset=utf-8;base64," + base64Data;
          link.download = userFileName;
          link.click(); // Инициируем скачивание браузером

          google.script.host.close(); // Закрываем диалог
        }).generateXmlContent();
      }
    </script>
  </body>
</html>
