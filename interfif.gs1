function sendToRosAccr() {
  const ui = SpreadsheetApp.getUi();

  // Запрос email пользователя
  const response = ui.prompt(
    'Передача в Росаккркдитацию',
    'пока функция не реализована:',
    ui.ButtonSet.OK
  );
}

